# 依赖
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量（重要！不要上传）
.env
.env.local
.env.*.local
*.env

# 构建输出
dist/
build/
*.log

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# 数据库文件（本地开发）
ekko-project/server/db/data/*.json
!ekko-project/server/db/data/.gitkeep

# 上传文件
ekko-project/server/uploads/*
!ekko-project/server/uploads/.gitkeep

# 临时文件
*.tmp
*.temp
.cache/

# 测试覆盖率
coverage/
.nyc_output/

# 调试
.vscode/launch.json
.vscode/settings.json

# 锁文件（可选，根据团队决定）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
