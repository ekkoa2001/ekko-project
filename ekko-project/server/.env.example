# Ekko Server 环境变量配置
# 复制此文件为 .env 并填写实际值

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=production

# ============================================
# Supabase Configuration
# ============================================
# 在 Supabase Dashboard > Settings > API 中获取
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ 注意：使用 service_role key，不是 anon key

# ============================================
# JWT Configuration
# ============================================
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# ============================================
# Cloudflare R2 Configuration
# ============================================
# 在 Cloudflare Dashboard > R2 中获取
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ekko-courses

# ============================================
# CORS Configuration
# ============================================
# 允许访问 API 的前端域名
FRONTEND_URL=https://your-frontend-domain.com

# 开发环境可以使用 localhost
# FRONTEND_URL=http://localhost:5173

# ============================================
# Rate Limiting (可选)
# ============================================
# 全局限流：每 15 分钟最多请求次数
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 登录限流：每小时最多登录次数
LOGIN_RATE_LIMIT_WINDOW_MS=3600000
LOGIN_RATE_LIMIT_MAX_REQUESTS=5

# ============================================
# 部署平台特定配置
# ============================================

# Zeabur 部署时，这些变量会自动设置：
# - PORT (由 Zeabur 自动分配)
# - NODE_ENV (建议设置为 production)

# 其他变量需要在 Zeabur Dashboard 中手动配置
